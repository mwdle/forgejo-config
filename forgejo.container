[Unit]
Wants=forgejo-cache.service
After=forgejo-cache.service
Wants=forgejo-db.service
After=forgejo-db.service

[Container]
Image=codeberg.org/forgejo/forgejo:16.0.6-rootless@sha256:51b47921660e1ec7127f094208fe06901ba57df4fe6d59fcccc3a2419514a77f
ContainerName=forgejo

Network=forgejo.network
Network=forgejo-cache.network
Network=forgejo-db.network

PublishPort=62222:62222

Secret=forgejo_db_password,target=db_password,uid=1000,gid=1000,mode=0400
Secret=forgejo_db_username,target=db_username,uid=1000,gid=1000,mode=0400
Secret=lab_smtp_password,target=smtp_password,uid=1000,gid=1000,mode=0400
Secret=lab_smtp_username,target=smtp_username,uid=1000,gid=1000,mode=0400

Environment=APP_NAME="mwdle Hosting"
Environment=FORGEJO__cache__ADAPTER=redis
Environment=FORGEJO__cache__HOST=redis://forgejo-cache:6379/0?pool_size=100&idle_timeout=180s
Environment=FORGEJO__database__DB_TYPE=postgres
Environment=FORGEJO__database__HOST=forgejo-db:5432
Environment=FORGEJO__database__NAME=forgejo
Environment=FORGEJO__database__PASSWD__FILE=/run/secrets/db_password
Environment=FORGEJO__database__USER__FILE=/run/secrets/db_username
Environment=FORGEJO__mailer__ENABLED=true
Environment=FORGEJO__mailer__FROM__FILE=/run/secrets/smtp_username
Environment=FORGEJO__mailer__PASSWD__FILE=/run/secrets/smtp_password
Environment=FORGEJO__mailer__PROTOCOL=smtps
Environment=FORGEJO__mailer__SMTP_ADDR=heracles.mxrouting.net
Environment=FORGEJO__mailer__SMTP_PORT=465
Environment=FORGEJO__mailer__SUBJECT_PREFIX=[Forgejo]
Environment=FORGEJO__mailer__USER__FILE=/run/secrets/smtp_username
Environment=FORGEJO__repository__ENABLE_PUSH_CREATE_ORG=true
Environment=FORGEJO__repository__ENABLE_PUSH_CREATE_USER=true
Environment=FORGEJO__security__REVERSE_PROXY_TRUSTED_PROXIES=10.89.0.0/16
Environment=FORGEJO__server__DOMAIN=git.mwdle.com
Environment=FORGEJO__server__ROOT_URL=https://git.mwdle.com/
Environment=FORGEJO__server__SSH_LISTEN_PORT=62222
Environment=FORGEJO__server__SSH_PORT=62222
Environment=FORGEJO__server__START_SSH_SERVER=true
Environment=FORGEJO__service__DEFAULT_KEEP_EMAIL_PRIVATE=true
Environment=FORGEJO__service__DISABLE_REGISTRATION=true
Environment=FORGEJO__service__ENABLE_BASIC_AUTHENTICATION=false
Environment=FORGEJO__service__ENABLE_NOTIFY_MAIL=true
Environment=FORGEJO__service__REQUIRE_CAPTCHA_FOR_LOGIN=true
Environment=FORGEJO__webhook__ALLOWED_HOST_LIST=jenkins.mwdle.com
Environment=FORGEJO__webhook__DELIVER_TIMEOUT=60
Environment=TZ=America/Denver
Environment=USER_UID=1000
Environment=USER_GID=1000

Volume=%h/containers/forgejo/data:/var/lib/gitea:U,Z

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp:noexec,nosuid

User=1000
Group=1000
UserNS=auto
NoNewPrivileges=true
DropCapability=all

HealthStartupCmd=wget --no-verbose --tries=1 --spider http://localhost:3000/api/healthz || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=wget --no-verbose --tries=1 --spider http://localhost:3000/api/healthz || exit 1
HealthInterval=60s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=512M
PidsLimit=100

[Service]
CPUQuota=75%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/forgejo/data

[Install]
WantedBy=default.target
